rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function shopData(id) { return get(/databases/$(database)/documents/shops/$(id)).data; }
    function isMember(id) { return signedIn() && me() in shopData(id).memberIds; }
    function canSeeAll(id) {
      let s = shopData(id);
      return signedIn() && me() in s.memberIds
        && (s.owner == me() || s.members[me()].get('role', 'manager') != 'staff');
    }
    function validDate(date) { return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function nearToday(date) {
      let p = date.split('-');
      let d = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.time > d - duration.value(4, 'h') && request.time < d + duration.value(46, 'h');
    }
    function canWriteDay(id, date) { return validDate(date) && (canSeeAll(id) || (isMember(id) && nearToday(date))); }
    match /users/{userId} {
      allow read, delete: if signedIn() && me() == userId;
      allow create, update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['shopId', 'shopIds', 'current'])
        && (!('shopIds' in request.resource.data) || (request.resource.data.shopIds is list && request.resource.data.shopIds.size() <= 20));
    }
    match /codes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['shopId'])
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.owner == me()
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.code == code;
      allow delete: if signedIn() && shopData(resource.data.shopId).owner == me();
    }
    match /shops/{shopId} {
      allow read: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.keys().hasOnly(['name', 'code', 'owner', 'memberIds', 'members', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.members.keys().hasOnly([me()])
        && existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code));
      allow update: if signedIn() && (
        (resource.data.owner == me()
          && request.resource.data.owner == me()
          && me() in request.resource.data.memberIds
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code', 'memberIds', 'members'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40)
        ||
        (!(me() in resource.data.memberIds)
          && request.resource.data.get('joinedWith', '') == resource.data.code
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinedWith'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([me()])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
          && request.resource.data.members[me()].keys().hasOnly(['name', 'joinedAt', 'role'])
          && request.resource.data.members[me()].role == 'staff'
          && request.resource.data.members[me()].name is string
          && request.resource.data.members[me()].name.size() <= 20)
        ||
        (me() in resource.data.memberIds
          && resource.data.owner != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([me()])
          && !(me() in request.resource.data.members))
      );
      allow delete: if false;
      match /records/{date} {
        allow list: if canSeeAll(shopId);
        allow get: if canSeeAll(shopId) || (isMember(shopId) && validDate(date) && nearToday(date));
        allow delete: if canWriteDay(shopId, date);
        allow create, update: if canWriteDay(shopId, date)
          && request.resource.data.keys().hasOnly(['cash', 'card', 'note', 'by', 'updatedAt', 'closed'])
          && (!('closed' in request.resource.data) || request.resource.data.closed is bool)
          && request.resource.data.cash is number
          && request.resource.data.card is number
          && request.resource.data.note is string && request.resource.data.note.size() <= 100
          && request.resource.data.by is string && request.resource.data.by.size() <= 40
          && request.resource.data.updatedAt == request.time;
      }
      match /logs/{logId} {
        allow read: if canSeeAll(shopId);
        allow update, delete: if false;
        allow create: if canWriteDay(shopId, request.resource.data.date)
          && request.resource.data.keys().hasOnly(['date', 'action', 'cash', 'card', 'note', 'by', 'uid', 'at'])
          && request.resource.data.uid == me()
          && request.resource.data.at == request.time
          && request.resource.data.action in ['save', 'rest', 'delete']
          && request.resource.data.cash is number
          && request.resource.data.card is number
          && request.resource.data.note is string && request.resource.data.note.size() <= 100
          && request.resource.data.by is string && request.resource.data.by.size() <= 40;
      }
      // 头像：成员都能看，只能改自己的；店铺 logo（_shop）只有店主能改
      match /avatars/{uid} {
        allow read: if isMember(shopId);
        allow write: if isMember(shopId) && (me() == uid || (uid == '_shop' && shopData(shopId).owner == me()))
          && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['img', 'at'])
            && request.resource.data.img is string && request.resource.data.img.size() < 200000));
      }
      // ================= OP本（进货发票付款记录）=================
      // 店主和「家人」能看能改；「店员」看不到
      match /opSuppliers/{supId} {
        allow read, delete: if canSeeAll(shopId);
        allow create, update: if canSeeAll(shopId)
          && request.resource.data.keys().hasOnly(['name', 'days', 'createdAt', 'usedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.days is int
          && request.resource.data.days >= 1 && request.resource.data.days <= 999;
      }
      match /opInvoices/{invId} {
        allow read, delete: if canSeeAll(shopId);
        allow create, update: if canSeeAll(shopId)
          && request.resource.data.keys().hasOnly(['supplierId', 'supplierName', 'no', 'amount', 'date', 'note',
               'paid', 'paidDate', 'paidBy', 'payMethod', 'cashPays', 'partial', 'by', 'invPh', 'payPh', 'createdAt', 'updatedAt'])
          && (!('cashPays' in request.resource.data) || (request.resource.data.cashPays is list && request.resource.data.cashPays.size() <= 200))
          && (!('partial' in request.resource.data) || request.resource.data.partial is bool)
          && (!('payMethod' in request.resource.data) || request.resource.data.payMethod in ['cash', 'op'])
          && request.resource.data.supplierId is string && request.resource.data.supplierId.size() <= 40
          && request.resource.data.supplierName is string && request.resource.data.supplierName.size() <= 60
          && request.resource.data.no is string && request.resource.data.no.size() <= 40
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0 && request.resource.data.amount < 100000000
          && validDate(request.resource.data.date)
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.paid is bool
          && (request.resource.data.paid == false || validDate(request.resource.data.paidDate))
          && request.resource.data.by is string && request.resource.data.by.size() <= 40
          && request.resource.data.invPh is list && request.resource.data.invPh.size() <= 4
          && request.resource.data.payPh is list && request.resource.data.payPh.size() <= 4
          && request.resource.data.updatedAt == request.time;
      }
      // OP本 修改记录：只能新增，谁都改不了、删不了
      match /opLogs/{logId} {
        allow read: if canSeeAll(shopId);
        allow update, delete: if false;
        allow create: if canSeeAll(shopId)
          && request.resource.data.keys().hasOnly(['action', 'text', 'ref', 'by', 'uid', 'at'])
          && request.resource.data.uid == me()
          && request.resource.data.at == request.time
          && request.resource.data.action in ['add', 'edit', 'pay', 'unpay', 'delete', 'sup', 'role']
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
          && request.resource.data.by is string && request.resource.data.by.size() <= 40;
      }
      match /opPhotos/{photoId} {
        allow read, delete: if canSeeAll(shopId);
        allow create, update: if canSeeAll(shopId)
          && request.resource.data.keys().hasOnly(['img', 'at'])
          && request.resource.data.img is string
          && request.resource.data.img.size() < 950000;
      }
    }
  }
}
